    {
      "name": "2. Future Reservations",
      "item": [
        {
          "name": "Create reservation - success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains reservation ID\", function () {",
                  "    const body = pm.response.json();",
                  "",
                  "    pm.expect(body.reservationId).to.exist;",
                  "    pm.collectionVariables.set(\"reservationId\", body.reservationId);",
                  "});",
                  "",
                  "pm.test(\"Reservation contains requested seat\", function () {",
                  "    const body = pm.response.json();",
                  "",
                  "    pm.expect(body.seatNumbers).to.include(\"A1\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"screeningId\": \"{{futureScreeningId}}\",\n  \"seatNumbers\": [\"A1\"],\n  \"customerAge\": 18\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations"
              ]
            }
          },
          "response": []
        },
